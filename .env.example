# Токен бота от @BotFather
BOT_TOKEN=

# Код из пригласительной ссылки: латиница, цифры, _ и -. Без него бот никому не отвечает.
ACCESS_CODE=

# Необязательные настройки (ниже значения по умолчанию)
# POLL_SECONDS=120
# WARN_MINUTES=15
# DATA_FILE=data/state.json

# Датчик света через Xiaomi Home (необязательно). Нужен вход: node tools/xiaomi-watch.js
# POWER_SENSOR_MODEL — устройство в обычной розетке, POWER_REFERENCE_MODELS — роутеры на ИБП через запятую.
# POWER_SENSOR_MODEL=lumi.gateway.mgl03
# POWER_REFERENCE_MODELS=xiaomi.router.rb01,xiaomi.router.rb02
# POWER_POLL_SECONDS=30
# Сколько минут ждать, прежде чем поверить изменению. Если шлюз часто обрывается, задайте, например, 5 и 2.
# POWER_OFF_MINUTES=0
# POWER_ON_MINUTES=0
